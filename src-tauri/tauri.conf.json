{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MX DeskWallet",
  "version": "1.1.0",
  "identifier": "com.mx.deskwallet",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir frontend/web build",
    "frontendDist": "../frontend/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MX DeskWallet",
        "width": 1080,
        "height": 680,
        "minWidth": 860,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
