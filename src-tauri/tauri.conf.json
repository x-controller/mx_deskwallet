{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portunus",
  "version": "1.4.0",
  "identifier": "com.mx.portunus",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir frontend/web build",
    "frontendDist": "../frontend/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Portunus",
        "width": 1080,
        "height": 680,
        "minWidth": 860,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4OTQzMjVCODVBMzEwN0UKUldSK0VLT0ZXektVMlBvZzJMVEFSaFJDZERROWxnZWkyTXgycitvM0RPRFl5RXJiSkp0bUtjOW4K",
      "endpoints": ["https://github.com/x-controller/Portunus/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
